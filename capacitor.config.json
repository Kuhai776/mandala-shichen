{
  "appId": "com.kuhai.mandala",
  "appName": "曼陀罗时辰",
  "webDir": "www",
  "appVersion": "2.3.10",
  "appVersionCode": 10,
  "server": {
    "cleartext": false
  },
  "android": {
    "allowMixedContent": false,
    "backgroundColor": "#1a1a2e",
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#1a1a2e",
      "overlaysWebView": false
    },
    "SplashScreen": {
      "launchShowDuration": 1000,
      "backgroundColor": "#1a1a2e",
      "showSpinner": false
    }
  }
}
