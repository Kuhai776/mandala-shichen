{
  "name": "mandala-shichen-apk",
  "version": "1.0.0",
  "description": "曼陀罗时辰 PWA → APK（Capacitor 打包）",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "open:android": "cap open android",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:debug": "cd android && ./gradlew assembleDebug",
    "serve": "npx http-server www -p 8080 -c-1 --cors",
    "start": "npm run serve",
    "install:export-plugins": "node scripts/install-export-plugins.js"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/clipboard": "^6.0.3",
    "@capacitor/core": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
